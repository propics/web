# Copy to .env.local (never commit real secrets).

# Inbox for Book Demo, Start Trial, and Contact API notifications.
# Defaults to the Propics Gmail if unset.
NOTIFICATION_EMAIL=propicsksa@gmail.com
BOOKING_NOTIFY_EMAIL=propicsksa@gmail.com

# Required to actually send mail (and create Book Demo calendar events).
# Sign in to propicsksa@gmail.com → Google Apps Script → paste the latest
# google-apps-script/Code.gs → Deploy → Manage deployments → New version
# (same URL). Execute as owner, anyone can access. Book Demo writes a
# 30-minute event on the calendar named "Propics Ksa".
# Without this URL, /api/book-demo, /api/free-trial, and /api/contact return 503
# unless BOOKING_DEV_MODE=true (validate-only; nothing is emailed).
GOOGLE_APPS_SCRIPT_URL=
BOOKING_DEV_MODE=true
